[Unit]
Description=BitcoinWalk production free-city events relay
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
StateDirectory=bitcoinwalk-relay-production
StateDirectoryMode=0700
WorkingDirectory=/var/lib/bitcoinwalk-relay-production
ExecStart=/opt/bitcoinwalk-relay-production/bitcoinwalk-relay
Environment=RELAY_LISTEN=127.0.0.1:3340
Environment=RELAY_DB=/var/lib/bitcoinwalk-relay-production/events.db
Environment=RELAY_ORGANIZER_MODE=true
Environment="RELAY_NAME=BitcoinWalk production events relay"
Environment="RELAY_DESCRIPTION=Shared Khatru relay for free-tier BitcoinWalk cities and their signed NIP-52 walks."
Environment="RELAY_LANDING_TEXT=BitcoinWalk production events relay. Public reads; authenticated organizer writes and super-admin approvals."
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
