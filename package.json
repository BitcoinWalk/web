{
  "name": "bitcoinwalk-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "journal:package": "node scripts/package-remote-journal.mjs",
    "journal:smoke": "node scripts/smoke-remote-journal.mjs",
    "payout:acceptance:build": "esbuild scripts/run-payout-acceptance.ts --bundle --platform=node --target=node24 --format=cjs --outfile=release-build/payout-acceptance.cjs",
    "payout:acceptance": "node release-build/payout-acceptance.cjs",
    "backlog:build": "node scripts/build-public-backlog.mjs",
    "backlog:check": "node scripts/build-public-backlog.mjs && test -f public-backlog-dist/index.html && grep -q 'BitcoinWalk backlog' public-backlog-dist/index.html && grep -q 'brand/bitcoinwalk-horizontal.png' public-backlog-dist/index.html && cmp public/brand/bitcoinwalk-horizontal.png public-backlog-dist/brand/bitcoinwalk-horizontal.png && test ! -e public-backlog-dist/CNAME",
    "hub-backup:check": "integrations/alby-fee-cap/backup/check-backup-package.sh",
    "rustress-secret:check": "scripts/test-rustress-secret-handoff.sh",
    "rustress-probe:build": "esbuild scripts/run-rustress-nwc-read-probe.ts --bundle --platform=node --target=node24 --format=cjs --outfile=release-build/rustress-nwc-read-probe.cjs",
    "rustress-unpaid-acceptance:build": "esbuild scripts/run-rustress-nwc-unpaid-acceptance.ts --bundle --platform=node --target=node24 --format=cjs --outfile=release-build/rustress-nwc-unpaid-acceptance.cjs",
    "rustress-unpaid-acceptance:package": "npm run rustress-unpaid-acceptance:build && scripts/package-rustress-unpaid-acceptance.sh",
    "rustress-shadow:build": "esbuild scripts/run-rustress-wallet-shadow.ts --bundle --platform=node --target=node24 --format=cjs --outfile=release-build/rustress-wallet-shadow.cjs && esbuild scripts/verify-rustress-wallet-shadow.ts --bundle --platform=node --target=node24 --format=cjs --outfile=release-build/verify-rustress-wallet-shadow.cjs",
    "rustress-shadow:package": "npm run rustress-shadow:build && scripts/package-rustress-wallet-shadow.sh",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "guide:build": "tsc -p tsconfig.guide.json && esbuild src/guide/service.ts --bundle --platform=node --target=node24 --format=cjs --outfile=guide-build/guide.cjs && esbuild src/guide/init-key.ts --bundle --platform=node --target=node24 --format=cjs --outfile=guide-build/guide-key.cjs",
    "guide:dry-run": "node guide-build/guide.cjs --dry-run",
    "dev": "next dev",
    "build": "next typegen && tsc --noEmit && next build",
    "release:package": "node scripts/package-staging.mjs staging",
    "release:package:production": "node scripts/package-staging.mjs production",
    "release:smoke": "node scripts/smoke-staging-package.mjs staging",
    "release:smoke:production": "node scripts/smoke-staging-package.mjs production",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "start": "next start",
    "lint": "eslint .",
    "logos:render": "node scripts/render-city-logo-pack.mjs",
    "logos:package": "node scripts/package-city-logo-renderer.mjs",
    "test": "vitest run",
    "test:rustress-api": "node scripts/test-rustress-api.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@photostructure/tz-lookup": "11.7.0",
    "@xmldom/xmldom": "0.9.12",
    "bolt11": "1.4.1",
    "leaflet": "latest",
    "maplibre-gl": "6.11.2",
    "next": "16.3.8",
    "nostr-tools": "latest",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/leaflet": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
