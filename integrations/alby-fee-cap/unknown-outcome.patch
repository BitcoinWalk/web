 )
 
+// PaymentOutcomeUnknownError means a send was attempted but the caller did not
+// observe a terminal wallet outcome. Callers must retain principal and fee
+// reservations and reconcile by payment hash before permitting a retry.
+type PaymentOutcomeUnknownError struct{ Err error }
+
+func NewPaymentOutcomeUnknownError(err error) error {
+	if err == nil {
+		err = errors.New("payment outcome unknown")
+	}
+	return &PaymentOutcomeUnknownError{Err: err}
+}
+
+func (err *PaymentOutcomeUnknownError) Error() string {
+	return fmt.Sprintf("payment outcome unknown: %v", err.Err)
+}
+func (err *PaymentOutcomeUnknownError) Unwrap() error { return err.Err }
+
+func IsPaymentOutcomeUnknown(err error) bool {
+	var unknown *PaymentOutcomeUnknownError
+	return errors.As(err, &unknown) || errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded)
+}
+
+// OutgoingPaymentLookupReconciler is an opt-in capability. A backend must only
+// return true when LookupInvoice can authoritatively reconcile outgoing pending
+// payments by their exact payment hash.
+type OutgoingPaymentLookupReconciler interface {
+	SupportsOutgoingPaymentLookupReconciliation() bool
+}
+
 // TLVRecord JSON tags are kept because values flow through the freeform
 // transaction Metadata blob and are surfaced to NIP-47 clients via
 // lookup_invoice / list_transactions.
