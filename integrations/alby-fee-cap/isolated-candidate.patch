+package ldk
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+// Executes the same helper used to populate RouteParametersConfig; no node,
+// network, seed, channel, real route or payment is created by this unit test.
+func TestBitcoinWalkRoutingFeeCeiling(t *testing.T) {
+	require.Equal(t, uint64(500000), getMaxTotalRoutingFeeLimit(50000000, nil))
+	require.Equal(t, uint64(10000), getMaxTotalRoutingFeeLimit(1000, nil))
+	for _, cap := range []uint64{0, 100000, 600000} {
+		require.Equal(t, cap, getMaxTotalRoutingFeeLimit(50000000, &cap))
+	}
+}
