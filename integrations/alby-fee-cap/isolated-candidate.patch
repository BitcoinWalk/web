diff --git i/transactions/bitcoinwalk_fee_cap_test.go w/transactions/bitcoinwalk_fee_cap_test.go
new file mode 100644
index 0000000..d6b2b02
--- /dev/null
+++ w/transactions/bitcoinwalk_fee_cap_test.go
@@ -0,0 +1,109 @@
+package transactions
+
+import (
+	"github.com/getAlby/hub/constants"
+	"github.com/getAlby/hub/db"
+	"github.com/getAlby/hub/lnclient"
+	"github.com/getAlby/hub/tests"
+	"github.com/stretchr/testify/require"
+	"math"
+	"testing"
+)
+
+type bitcoinwalkCaptureLn struct {
+	lnclient.LNClient
+	send func(string, *uint64, *uint64) (*lnclient.PayInvoiceResponse, error)
+}
+
+func (l bitcoinwalkCaptureLn) SendPaymentSync(i string, a, f *uint64) (*lnclient.PayInvoiceResponse, error) {
+	return l.send(i, a, f)
+}
+
+func TestBitcoinWalkFeeReserveMatchesCap(t *testing.T) {
+	for _, fee := range []uint64{0, 100000, 600000} {
+		t.Run(string(rune('a'+fee/100000)), func(t *testing.T) {
+			svc, err := tests.CreateTestService(t)
+			require.NoError(t, err)
+			defer svc.Remove()
+			amount := uint64(50000000)
+			backend := bitcoinwalkCaptureLn{LNClient: svc.LNClient, send: func(_ string, a, f *uint64) (*lnclient.PayInvoiceResponse, error) {
+				require.Equal(t, amount, *a)
+				require.Equal(t, fee, *f)
+				var row db.Transaction
+				require.NoError(t, svc.DB.Where("payment_hash = ? AND type = ?", tests.MockZeroAmountPaymentHash, constants.TRANSACTION_TYPE_OUTGOING).First(&row).Error)
+				require.Equal(t, fee, row.FeeReserveMsat, "durable pending reserve must use requested fee cap")
+				require.Equal(t, constants.TRANSACTION_STATE_PENDING, row.State)
+				// Reconstruct the service while the durable payment is pending:
+				// a retry must fail before any second backend call.
+				_, retryErr := NewTransactionsService(svc.DB, svc.EventPublisher).SendPaymentSync(tests.MockZeroAmountInvoice, &amount, &fee, nil, svc.LNClient, nil, nil)
+				require.ErrorContains(t, retryErr, "already a payment pending")
+				return &lnclient.PayInvoiceResponse{Preimage: "synthetic"}, nil
+			}}
+			_, err = NewTransactionsService(svc.DB, svc.EventPublisher).SendPaymentSync(tests.MockZeroAmountInvoice, &amount, &fee, nil, backend, nil, nil)
+			require.NoError(t, err)
+		})
+	}
+}
+
+func TestBitcoinWalkPilotBudgetBoundary(t *testing.T) {
+	for _, spent := range []uint64{149900000, 149900001, 149901000} {
+		t.Run(string(rune('a'+(spent-149900000)/1000)), func(t *testing.T) {
+			svc, err := tests.CreateTestService(t)
+			require.NoError(t, err)
+			defer svc.Remove()
+			app, _, err := tests.CreateApp(svc)
+			require.NoError(t, err)
+			require.NoError(t, svc.DB.Create(&db.AppPermission{AppId: app.ID, Scope: constants.PAY_INVOICE_SCOPE, MaxAmountSat: 200000}).Error)
+			require.NoError(t, svc.DB.Create(&db.Transaction{AppId: &app.ID, Type: constants.TRANSACTION_TYPE_OUTGOING, State: constants.TRANSACTION_STATE_SETTLED, AmountMsat: spent, PaymentHash: "synthetic-previous"}).Error)
+			amount, fee := uint64(50000000), uint64(100000)
+			called := false
+			backend := bitcoinwalkCaptureLn{LNClient: svc.LNClient, send: func(_ string, _, f *uint64) (*lnclient.PayInvoiceResponse, error) {
+				called = true
+				require.Equal(t, fee, *f)
+				return &lnclient.PayInvoiceResponse{Preimage: "synthetic", FeeMsat: fee}, nil
+			}}
+			_, err = NewTransactionsService(svc.DB, svc.EventPublisher).SendPaymentSync(tests.MockZeroAmountInvoice, &amount, &fee, nil, backend, &app.ID, nil)
+			if spent == 149900000 {
+				require.NoError(t, err)
+				require.True(t, called)
+			} else {
+				require.Error(t, err)
+				require.False(t, called)
+			}
+		})
+	}
+}
+
+func TestBitcoinWalkBudgetCountsRequestedFee(t *testing.T) {
+	svc, err := tests.CreateTestService(t)
+	require.NoError(t, err)
+	defer svc.Remove()
+	app, _, err := tests.CreateApp(svc)
+	require.NoError(t, err)
+	require.NoError(t, svc.DB.Create(&db.AppPermission{AppId: app.ID, Scope: constants.PAY_INVOICE_SCOPE, MaxAmountSat: 200}).Error)
+	fee := uint64(100000)
+	called := false
+	backend := bitcoinwalkCaptureLn{LNClient: svc.LNClient, send: func(_ string, _, _ *uint64) (*lnclient.PayInvoiceResponse, error) {
+		called = true
+		return &lnclient.PayInvoiceResponse{Preimage: "synthetic"}, nil
+	}}
+	// 123 sat invoice + 100 sat cap exceeds the non-renewing 200 sat allowance.
+	_, err = NewTransactionsService(svc.DB, svc.EventPublisher).SendPaymentSync(tests.MockInvoice, nil, &fee, nil, backend, &app.ID, nil)
+	require.Error(t, err)
+	require.False(t, called, "backend must not be called above budget")
+}
+
+func TestBitcoinWalkRejectsOverflowBeforeBackend(t *testing.T) {
+	svc, err := tests.CreateTestService(t)
+	require.NoError(t, err)
+	defer svc.Remove()
+	fee := uint64(math.MaxUint64)
+	called := false
+	backend := bitcoinwalkCaptureLn{LNClient: svc.LNClient, send: func(_ string, _, _ *uint64) (*lnclient.PayInvoiceResponse, error) {
+		called = true
+		return &lnclient.PayInvoiceResponse{Preimage: "synthetic"}, nil
+	}}
+	_, err = NewTransactionsService(svc.DB, svc.EventPublisher).SendPaymentSync(tests.MockInvoice, nil, &fee, nil, backend, nil, nil)
+	require.Error(t, err)
+	require.False(t, called)
+}
