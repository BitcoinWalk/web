@@ -0,0 +1,16 @@
+package ldk
+
+import "github.com/getAlby/hub/lnclient"
+
+func (ls *LDKService) BitcoinWalkPaymentSafetyCapabilities() lnclient.PaymentSafetyCapabilities {
+	return lnclient.PaymentSafetyCapabilities{
+		Contract:                     lnclient.BitcoinWalkPaymentSafetyContract,
+		CandidateRevision:            lnclient.BitcoinWalkPaymentSafetyCandidate,
+		UpstreamCommit:               lnclient.BitcoinWalkPaymentSafetyUpstream,
+		Backend:                      "ldk",
+		ExplicitFeeCeiling:           true,
+		UnknownOutcomeReservation:    true,
+		OutgoingLookupReconciliation: true,
+		LegacyFailedQuarantine:       true,
+	}
+}
diff --git a/lnclient/ldk/bitcoinwalk_payment_safety_test.go b/lnclient/ldk/bitcoinwalk_payment_safety_test.go
new file mode 100644
--- /dev/null
+++ b/lnclient/ldk/bitcoinwalk_payment_safety_test.go
@@ -0,0 +1,21 @@
+package ldk
+
+import (
+	"testing"
+
+	"github.com/getAlby/hub/lnclient"
+	"github.com/stretchr/testify/require"
+)
+
+func TestBitcoinWalkPaymentSafetyCapability(t *testing.T) {
+	var provider lnclient.PaymentSafetyCapabilityProvider = &LDKService{}
+	capability := provider.BitcoinWalkPaymentSafetyCapabilities()
+	require.Equal(t, lnclient.BitcoinWalkPaymentSafetyContract, capability.Contract)
+	require.Equal(t, lnclient.BitcoinWalkPaymentSafetyCandidate, capability.CandidateRevision)
+	require.Equal(t, lnclient.BitcoinWalkPaymentSafetyUpstream, capability.UpstreamCommit)
+	require.Equal(t, "ldk", capability.Backend)
+	require.True(t, capability.ExplicitFeeCeiling)
+	require.True(t, capability.UnknownOutcomeReservation)
+	require.True(t, capability.OutgoingLookupReconciliation)
+	require.True(t, capability.LegacyFailedQuarantine)
+}
diff --git a/nip47/controllers/bitcoinwalk_payment_safety_test.go b/nip47/controllers/bitcoinwalk_payment_safety_test.go
new file mode 100644
--- /dev/null
+++ b/nip47/controllers/bitcoinwalk_payment_safety_test.go
@@ -0,0 +1,68 @@
+package controllers
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/getAlby/go-nostr"
+	"github.com/getAlby/hub/db"
+	"github.com/getAlby/hub/lnclient"
+	"github.com/getAlby/hub/nip47/models"
+	"github.com/getAlby/hub/tests"
+	"github.com/stretchr/testify/require"
+)
+
+type bitcoinWalkCapabilityBackend struct{ lnclient.LNClient }
+
+func (bitcoinWalkCapabilityBackend) BitcoinWalkPaymentSafetyCapabilities() lnclient.PaymentSafetyCapabilities {
+	return lnclient.PaymentSafetyCapabilities{
+		Contract:          lnclient.BitcoinWalkPaymentSafetyContract,
+		CandidateRevision: lnclient.BitcoinWalkPaymentSafetyCandidate,
+		UpstreamCommit:    lnclient.BitcoinWalkPaymentSafetyUpstream,
+		Backend:           "ldk", ExplicitFeeCeiling: true,
+		UnknownOutcomeReservation: true, OutgoingLookupReconciliation: true,
+		LegacyFailedQuarantine: true,
+	}
+}
+
+func TestBitcoinWalkGetInfoBindsPaymentSafetyCapability(t *testing.T) {
+	svc, err := tests.CreateTestService(t)
+	require.NoError(t, err)
+	defer svc.Remove()
+	app, _, err := tests.CreateApp(svc)
+	require.NoError(t, err)
+	svc.LNClient = bitcoinWalkCapabilityBackend{LNClient: svc.LNClient}
+	request := &models.Request{}
+	require.NoError(t, json.Unmarshal([]byte(nip47GetInfoJson), request))
+	requestEvent := &db.RequestEvent{}
+	require.NoError(t, svc.DB.Create(requestEvent).Error)
+	var response *models.Response
+	NewTestNip47Controller(svc).HandleGetInfoEvent(context.Background(), request, requestEvent.ID, app, func(value *models.Response, _ nostr.Tags) { response = value })
+	require.NotNil(t, response)
+	require.Nil(t, response.Error)
+	info := response.Result.(*getInfoResponse)
+	require.NotNil(t, info.PaymentSafety)
+	require.Equal(t, lnclient.BitcoinWalkPaymentSafetyCandidate, info.PaymentSafety.CandidateRevision)
+	require.Equal(t, "ldk", info.PaymentSafety.Backend)
+	require.True(t, info.PaymentSafety.ExplicitFeeCeiling)
+	require.True(t, info.PaymentSafety.UnknownOutcomeReservation)
+	require.True(t, info.PaymentSafety.OutgoingLookupReconciliation)
+	require.True(t, info.PaymentSafety.LegacyFailedQuarantine)
+}
+
+func TestBitcoinWalkGetInfoOmitsUnverifiedPaymentSafetyCapability(t *testing.T) {
+	svc, err := tests.CreateTestService(t)
+	require.NoError(t, err)
+	defer svc.Remove()
+	app, _, err := tests.CreateApp(svc)
+	require.NoError(t, err)
+	request := &models.Request{}
+	require.NoError(t, json.Unmarshal([]byte(nip47GetInfoJson), request))
+	requestEvent := &db.RequestEvent{}
+	require.NoError(t, svc.DB.Create(requestEvent).Error)
+	var response *models.Response
+	NewTestNip47Controller(svc).HandleGetInfoEvent(context.Background(), request, requestEvent.ID, app, func(value *models.Response, _ nostr.Tags) { response = value })
+	require.NotNil(t, response)
+	require.Nil(t, response.Result.(*getInfoResponse).PaymentSafety)
+}
