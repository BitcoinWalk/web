diff --git a/lnclient/bitcoinwalk_payment_safety.go b/lnclient/bitcoinwalk_payment_safety.go
new file mode 100644
--- /dev/null
+++ b/lnclient/bitcoinwalk_payment_safety.go
@@ -0,0 +1,23 @@
+package lnclient
+
+const BitcoinWalkPaymentSafetyContract = "bitcoinwalk-payment-safety-v1"
+const BitcoinWalkPaymentSafetyCandidate = "6bb8520025d781f8570ef1a5d134fe545a1586f3ab46cfedd780e15a641cfa84"
+const BitcoinWalkPaymentSafetyUpstream = "a231ed34a660cd86c0bd7f36282f7eb0dc90223f"
+
+// PaymentSafetyCapabilities is returned inside the authenticated NIP-47
+// get_info response. It binds BitcoinWalk to the exact reviewed LDK safety
+// contract instead of trusting a generic method list or deployment label.
+type PaymentSafetyCapabilities struct {
+	Contract                     string `json:"contract"`
+	CandidateRevision            string `json:"candidate_revision"`
+	UpstreamCommit               string `json:"upstream_commit"`
+	Backend                      string `json:"backend"`
+	ExplicitFeeCeiling           bool   `json:"explicit_fee_ceiling"`
+	UnknownOutcomeReservation    bool   `json:"unknown_outcome_reservation"`
+	OutgoingLookupReconciliation bool   `json:"outgoing_lookup_reconciliation"`
+	LegacyFailedQuarantine       bool   `json:"legacy_failed_quarantine"`
+}
+
+type PaymentSafetyCapabilityProvider interface {
+	BitcoinWalkPaymentSafetyCapabilities() PaymentSafetyCapabilities
+}
