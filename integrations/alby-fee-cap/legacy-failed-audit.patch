+package transactions
+
+import (
+	"testing"
+	"time"
+
+	"github.com/getAlby/hub/constants"
+	"github.com/getAlby/hub/db"
+	"github.com/getAlby/hub/db/queries"
+	"github.com/getAlby/hub/tests"
+	"github.com/stretchr/testify/require"
+)
+
+func createLegacyFailedFixture(t *testing.T, svc *tests.TestService, appID uint, hash string, amount uint64, createdAt time.Time) db.Transaction {
+	t.Helper()
+	row := db.Transaction{
+		AppId: &appID, Type: constants.TRANSACTION_TYPE_OUTGOING,
+		State: constants.TRANSACTION_STATE_FAILED, AmountMsat: amount,
+		PaymentRequest: "lnbcrt1legacyfixture", PaymentHash: hash,
+		FailureReason: "context deadline exceeded", CreatedAt: createdAt,
+	}
+	require.NoError(t, svc.DB.Create(&row).Error)
+	return row
+}
+
+func TestBitcoinWalkLegacyFailedAuditAndQuarantine(t *testing.T) {
+	svc, err := tests.CreateTestService(t)
+	require.NoError(t, err)
+	defer svc.Remove()
+	app, _, err := tests.CreateApp(svc)
+	require.NoError(t, err)
+	other, _, err := tests.CreateApp(svc)
+	require.NoError(t, err)
+	permission := db.AppPermission{AppId: app.ID, Scope: constants.PAY_INVOICE_SCOPE, MaxAmountSat: 200000}
+	require.NoError(t, svc.DB.Create(&permission).Error)
+
+	cutoff := time.Now().UTC().Add(-time.Hour)
+	first := createLegacyFailedFixture(t, svc, app.ID, "legacy-one", 50_000_000, cutoff.Add(-time.Hour))
+	second := createLegacyFailedFixture(t, svc, app.ID, "legacy-two", 25_000_000, cutoff.Add(-time.Minute))
+	createLegacyFailedFixture(t, svc, other.ID, "other-app", 10_000_000, cutoff.Add(-time.Minute))
+	createLegacyFailedFixture(t, svc, app.ID, "after-cutoff", 5_000_000, cutoff.Add(time.Minute))
+
+	audit, err := AuditLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000)
+	require.NoError(t, err)
+	require.Equal(t, 2, audit.Count)
+	require.Equal(t, uint64(75_000_000), audit.PrincipalMsat)
+	require.Equal(t, []uint{first.ID, second.ID}, audit.TransactionIDs)
+	require.Empty(t, audit.BlockingProblems)
+	require.Len(t, audit.Fingerprint, 64)
+
+	var stillFailed int64
+	require.NoError(t, svc.DB.Model(&db.Transaction{}).Where("id IN ? AND state = ?", audit.TransactionIDs, constants.TRANSACTION_STATE_FAILED).Count(&stillFailed).Error)
+	require.Equal(t, int64(2), stillFailed, "audit must not mutate payment state")
+
+	applied, err := QuarantineLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000, audit.Fingerprint)
+	require.NoError(t, err)
+	require.Equal(t, audit.Fingerprint, applied.Fingerprint)
+
+	var quarantined []db.Transaction
+	require.NoError(t, svc.DB.Where("id IN ?", audit.TransactionIDs).Order("id ASC").Find(&quarantined).Error)
+	require.Len(t, quarantined, 2)
+	for _, row := range quarantined {
+		require.Equal(t, constants.TRANSACTION_STATE_PENDING, row.State)
+		require.Equal(t, uint64(100_000), row.FeeReserveMsat)
+		require.Equal(t, "context deadline exceeded", row.FailureReason, "original evidence must remain")
+	}
+	usage, err := queries.GetBudgetUsageMsat(svc.DB, &permission)
+	require.NoError(t, err)
+	require.Equal(t, uint64(75_200_000), usage)
+
+	// A caller that lost the success response can safely submit the exact batch
+	// again; no row or reserve is duplicated.
+	repeated, err := QuarantineLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000, audit.Fingerprint)
+	require.NoError(t, err)
+	require.Equal(t, 2, repeated.Count)
+	var records int64
+	require.NoError(t, svc.DB.Table("bitcoinwalk_legacy_failed_payment_records").Count(&records).Error)
+	require.Equal(t, int64(2), records)
+
+	var untouched int64
+	require.NoError(t, svc.DB.Model(&db.Transaction{}).Where("payment_hash IN ? AND state = ?", []string{"other-app", "after-cutoff"}, constants.TRANSACTION_STATE_FAILED).Count(&untouched).Error)
+	require.Equal(t, int64(2), untouched)
+}
+
+func TestBitcoinWalkLegacyFailedQuarantineRejectsDriftAndMalformedRows(t *testing.T) {
+	svc, err := tests.CreateTestService(t)
+	require.NoError(t, err)
+	defer svc.Remove()
+	app, _, err := tests.CreateApp(svc)
+	require.NoError(t, err)
+	cutoff := time.Now().UTC()
+	row := createLegacyFailedFixture(t, svc, app.ID, "legacy-drift", 50_000_000, cutoff.Add(-time.Minute))
+
+	audit, err := AuditLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000)
+	require.NoError(t, err)
+	require.NoError(t, svc.DB.Model(&db.Transaction{}).Where("id = ?", row.ID).Update("failure_reason", "changed after audit").Error)
+	_, err = QuarantineLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000, audit.Fingerprint)
+	require.ErrorContains(t, err, "audit changed")
+
+	newAudit, err := AuditLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000)
+	require.NoError(t, err)
+	require.NoError(t, svc.DB.Model(&db.Transaction{}).Where("id = ?", row.ID).Update("payment_request", "").Error)
+	malformed, err := AuditLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000)
+	require.NoError(t, err)
+	require.NotEmpty(t, malformed.BlockingProblems)
+	_, err = QuarantineLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000, malformed.Fingerprint)
+	require.ErrorContains(t, err, "audit is blocked")
+
+	_, err = QuarantineLegacyFailedOutgoingPayments(svc.DB, app.ID, cutoff, 100_000, newAudit.Fingerprint)
+	require.ErrorContains(t, err, "audit changed")
+	var state string
+	require.NoError(t, svc.DB.Model(&db.Transaction{}).Select("state").Where("id = ?", row.ID).Scan(&state).Error)
+	require.Equal(t, constants.TRANSACTION_STATE_FAILED, state)
+}

