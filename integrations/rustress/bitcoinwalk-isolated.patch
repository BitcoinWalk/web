+        city_id: "00000000-0000-4000-8000-000000000001".into(),
+        version: 1,
+        domain: "bitcoinwalk.org".into(),
+        local_part: "fixture-city".into(),
+        brand_pubkey: "a".repeat(64),
+        authority_event_id: "b".repeat(64),
+        approval_event_id: "c".repeat(64),
+        brand_event_id: "d".repeat(64),
