+async fn concurrent_apply_and_restart_keep_exactly_one_user() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("restart.fixture.sqlite");
+    let options = SqliteConnectOptions::new()
+        .filename(&path)
+        .create_if_missing(true)
+        .busy_timeout(Duration::from_secs(5));
+    let mut s = state().await;
+    s.pool.close().await;
+    s.pool = SqlitePool::connect_with(options.clone()).await.unwrap();
+    migrate(&s.pool).await.unwrap();
+    let cmd = command(config());
+    change(&s, &cmd, false).await.unwrap();
+    let (a, b) = tokio::join!(change(&s, &cmd, true), change(&s, &cmd, true));
+    assert_eq!(a.unwrap(), b.unwrap());
+    s.pool.close().await;
+    s.pool = SqlitePool::connect_with(options).await.unwrap();
+    migrate(&s.pool).await.unwrap();
+    assert_eq!(change(&s, &cmd, true).await.unwrap().state, "applied");
+    assert_eq!(count(&s, "users").await, 1);
+    assert_eq!(count(&s, "prism_splits").await, 1);
