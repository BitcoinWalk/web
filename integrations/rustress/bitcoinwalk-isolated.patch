+//! BW-100: private provisioning in a separately stamped fixture database only.
+//! No public address, invoice or wallet functionality is registered in this mode.
+use actix_web::{App, HttpRequest, HttpResponse, HttpServer, web};
+use rand::RngCore;
+use regex::Regex;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use sqlx::{Row, SqlitePool, sqlite::SqliteConnectOptions};
+use std::{path::Path, str::FromStr, sync::LazyLock, time::Duration};
+
+use crate::bitcoinwalk_issuer::{InvoiceBroker, IssueRequest};
+
+const API: &str = "bitcoinwalk-provisioning-v1";
+const UPSTREAM: &str = "c72fdeccd80025d181efc1b1d45baeb8bfbde4a9";
+const MAX_SAFE: u64 = 9_007_199_254_740_991;
+static HEX: LazyLock<Regex> = LazyLock::new(|| Regex::new(r"^[0-9a-f]{64}$").unwrap());
+static ID: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")
+        .unwrap()
+});
+static LABEL: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"^[a-z0-9]+(?:-[a-z0-9]+)*$").unwrap());
+static DOMAIN: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,63}$").unwrap());
+static PAYOUT: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"^(?:[A-Za-z0-9._+-]+@[a-z0-9.-]+\.[a-z]{2,63}|lnurl1[02-9ac-hj-np-z]+)$").unwrap()
+});
+
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Config {
+    city_id: String,
+    version: u64,
+    domain: String,
+    local_part: String,
+    brand_pubkey: String,
+    authority_event_id: String,
+    approval_event_id: String,
+    brand_event_id: String,
+    payout_version: u64,
+    payout_destination: String,
+    wallet_ref: String,
+    organizer_basis_points: u16,
+    retained_basis_points: u16,
+    invoice_issuance: String,
+}
+impl Config {
+    fn valid(&self, domain: &str, managed: bool) -> bool {
+        ID.is_match(&self.city_id)
+            && (1..=MAX_SAFE).contains(&self.version)
+            && (1..=MAX_SAFE).contains(&self.payout_version)
+            && self.domain == domain
+            && DOMAIN.is_match(&self.domain)
+            && self.domain.len() <= 253
+            && LABEL.is_match(&self.local_part)
+            && self.local_part.len() <= 63
+            && LABEL.is_match(&self.wallet_ref)
+            && self.wallet_ref.len() <= 63
+            && [
+                &self.brand_pubkey,
+                &self.authority_event_id,
+                &self.approval_event_id,
+                &self.brand_event_id,
+            ]
+            .iter()
+            .all(|v| HEX.is_match(v))
+            && self.payout_destination.len() <= 500
+            && PAYOUT.is_match(&self.payout_destination)
+            && self.payout_destination.to_lowercase()
+                != format!("{}@{}", self.local_part, self.domain)
+            && self.organizer_basis_points == 7900
+            && self.retained_basis_points == 2100
+            && if managed {
+                matches!(self.invoice_issuance.as_str(), "disabled" | "enabled")
+            } else {
+                self.invoice_issuance == "disabled"
+            }
+    }
+    fn hash(&self) -> String {
+        // Struct field order is the app's canonical zod field order.
+        format!("{:x}", Sha256::digest(serde_json::to_vec(self).unwrap()))
+    }
+}
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Command {
+    api: String,
+    expected_version: u64,
+    idempotency_key: String,
+    config: Config,
+}
+#[derive(Debug, Deserialize, Serialize, PartialEq)]
+#[serde(rename_all = "camelCase")]
+struct Receipt {
+    api: String,
+    city_id: String,
+    version: u64,
+    config_hash: String,
+    state: String,
+    invoice_issuance: String,
+}
+fn receipt(c: &Config, state: &str) -> Receipt {
+    Receipt {
+        api: API.into(),
+        city_id: c.city_id.clone(),
+        version: c.version,
+        config_hash: c.hash(),
+        state: state.into(),
+        invoice_issuance: c.invoice_issuance.clone(),
+    }
+}
+struct State {
+    pool: SqlitePool,
+    token_hash: [u8; 32],
+    domain: String,
+    revision: String,
+    wallets: Vec<String>,
+    managed: bool,
+    broker: Option<InvoiceBroker>,
+}
+fn authorized(req: &HttpRequest, state: &State) -> bool {
+    let headers: Vec<_> = req.headers().get_all("authorization").collect();
+    if headers.len() != 1 {
+        return false;
+    }
+    let Some(token) = headers[0]
+        .to_str()
+        .ok()
+        .and_then(|v| v.strip_prefix("Bearer "))
+    else {
+        return false;
+    };
+    if token.len() > 256 {
+        return false;
+    }
+    let digest = Sha256::digest(token.as_bytes());
+    digest
+        .iter()
+        .zip(state.token_hash)
+        .fold(0u8, |a, (b, c)| a | (b ^ c))
+        == 0
+}
+fn error(status: actix_web::http::StatusCode) -> HttpResponse {
+    HttpResponse::build(status)
+        .insert_header(("Cache-Control", "no-store"))
+        .json(serde_json::json!({"error":"Provisioning request could not be completed"}))
+}
+use actix_web::http::StatusCode as Status;
+async fn capabilities(req: HttpRequest, state: web::Data<State>) -> HttpResponse {
+    if !authorized(&req, &state) {
+        return error(Status::UNAUTHORIZED);
+    }
+    HttpResponse::Ok()
+        .insert_header(("Cache-Control", "no-store"))
+        .json(serde_json::json!({
+            "api": API, "upstreamCommit": UPSTREAM, "adapterRevision": state.revision,
+            "domain": state.domain, "atomicConfiguration": true, "managedEntriesOnly": true,
+            "compareAndSwap": true, "idempotency": true, "invoiceIssuanceGate": true
+        }))
+}
+
+async fn read_status(
+    req: HttpRequest,
+    state: web::Data<State>,
+    id: web::Path<String>,
+) -> HttpResponse {
+    if !authorized(&req, &state) {
+        return error(Status::UNAUTHORIZED);
+    }
+    if !ID.is_match(&id) {
+        return error(Status::BAD_REQUEST);
+    }
+    let Ok(mut tx) = state.pool.begin().await else {
+        return error(Status::SERVICE_UNAVAILABLE);
+    };
+    match sqlx::query(
+        "SELECT config,state FROM bw_configs WHERE city_id=? ORDER BY version DESC LIMIT 1",
+    )
+    .bind(id.into_inner())
+    .fetch_optional(&mut *tx)
+    .await
+    {
+        Ok(Some(row)) => match serde_json::from_str::<Config>(row.get("config")) {
+            Ok(config) => {
+                if row.get::<String, _>("state") == "applied"
+                    && verify_applied(&mut tx, &config).await.is_err()
+                {
+                    return error(Status::SERVICE_UNAVAILABLE);
+                }
+                HttpResponse::Ok()
+                    .insert_header(("Cache-Control", "no-store"))
+                    .json(receipt(&config, row.get("state")))
+            }
+            Err(_) => error(Status::SERVICE_UNAVAILABLE),
+        },
+        Ok(None) => error(Status::NOT_FOUND),
+        Err(_) => error(Status::SERVICE_UNAVAILABLE),
+    }
+}
+
+#[derive(Debug)]
+enum Failure {
+    Conflict,
+    Storage,
+}
+impl From<sqlx::Error> for Failure {
+    fn from(_: sqlx::Error) -> Self {
+        Self::Storage
+    }
+}
+
+async fn verify_applied(conn: &mut sqlx::SqliteConnection, c: &Config) -> Result<(), Failure> {
+    let row = sqlx::query("SELECT users.id,username,users.domain,nostr_pubkey,nwc_uri,is_prism FROM bw_claims JOIN users ON users.id=bw_claims.user_id WHERE city_id=?")
+        .bind(&c.city_id).fetch_optional(&mut *conn).await?.ok_or(Failure::Conflict)?;
+    let splits =
+        sqlx::query("SELECT lightning_address,percentage FROM prism_splits WHERE user_id=?")
+            .bind(row.get::<i64, _>("id"))
+            .fetch_all(&mut *conn)
+            .await?;
+    if row.get::<String, _>("username") != c.local_part
+        || row.get::<String, _>("domain") != c.domain
+        || row.get::<Option<String>, _>("nwc_uri").is_some()
+        || !row.get::<bool, _>("is_prism")
+        || row.get::<Option<String>, _>("nostr_pubkey").as_deref() != Some(c.brand_pubkey.as_str())
+        || splits.len() != 1
+        || splits[0].get::<String, _>("lightning_address") != c.payout_destination
+        || splits[0].get::<f64, _>("percentage") != 79.0
+    {
+        return Err(Failure::Conflict);
+    }
+    Ok(())
+}
+
+async fn change(state: &State, cmd: &Command, apply: bool) -> Result<Receipt, Failure> {
+    let c = &cmd.config;
+    let mut tx = state.pool.begin().await?;
+    // Acquire the SQLite writer lock BEFORE reading heads/claims. Concurrent
+    // writers wait or fail; no outside API call is made within this transaction.
+    sqlx::query("UPDATE bw_lock SET value=value WHERE id=1")
+        .execute(&mut *tx)
+        .await?;
+    let prior = sqlx::query("SELECT version,hash,state,config FROM bw_configs WHERE city_id=? ORDER BY version DESC LIMIT 1")
+        .bind(&c.city_id).fetch_optional(&mut *tx).await?;
+    if let Some(row) = &prior {
+        let v: i64 = row.get("version");
+        if v == c.version as i64 {
+            if row.get::<String, _>("hash") != c.hash() {
+                return Err(Failure::Conflict);
+            }
+            if !apply || row.get::<String, _>("state") == "applied" {
+                if row.get::<String, _>("state") == "applied" {
+                    verify_applied(&mut tx, c).await?;
+                }
+                let result = receipt(c, row.get("state"));
+                tx.commit().await?;
+                return Ok(result);
+            }
+        } else if v + 1 != c.version as i64 || row.get::<String, _>("state") != "applied" || apply {
+            return Err(Failure::Conflict);
+        }
+    } else if c.version != 1 || apply {
+        return Err(Failure::Conflict);
+    }
+
+    let claim = sqlx::query("SELECT domain,local_part,user_id FROM bw_claims WHERE city_id=?")
+        .bind(&c.city_id)
+        .fetch_optional(&mut *tx)
+        .await?;
+    if let Some(row) = &claim {
+        if row.get::<String, _>("domain") != c.domain
+            || row.get::<String, _>("local_part") != c.local_part
+        {
+            return Err(Failure::Conflict);
+        }
+    }
+    // Check names against EVERY upstream entry, including unmanaged accounts.
+    let user = sqlx::query("SELECT id,nostr_pubkey,nwc_uri,is_prism FROM users WHERE username=? COLLATE NOCASE AND domain=? COLLATE NOCASE")
+        .bind(&c.local_part).bind(&c.domain).fetch_optional(&mut *tx).await?;
+    let claimed_id = claim
+        .as_ref()
+        .and_then(|r| r.get::<Option<i64>, _>("user_id"));
+    if user.as_ref().map(|r| r.get::<i64, _>("id")) != claimed_id {
+        return Err(Failure::Conflict);
+    }
+    if let Some(u) = &user {
+        // Refuse any wallet secret or out-of-band drift, rather than overwriting it.
+        let old = sqlx::query("SELECT config FROM bw_configs WHERE city_id=? AND state='applied' ORDER BY version DESC LIMIT 1")
+            .bind(&c.city_id).fetch_optional(&mut *tx).await?.ok_or(Failure::Conflict)?;
+        let old: Config = serde_json::from_str(old.get("config")).map_err(|_| Failure::Storage)?;
+        let splits =
+            sqlx::query("SELECT lightning_address,percentage FROM prism_splits WHERE user_id=?")
+                .bind(claimed_id)
+                .fetch_all(&mut *tx)
+                .await?;
+        if u.get::<Option<String>, _>("nwc_uri").is_some()
+            || u.get::<Option<String>, _>("nostr_pubkey").as_deref() != Some(&old.brand_pubkey)
+            || !u.get::<bool, _>("is_prism")
+            || splits.len() != 1
+            || splits[0].get::<String, _>("lightning_address") != old.payout_destination
+            || splits[0].get::<f64, _>("percentage") != 79.0
+        {
+            return Err(Failure::Conflict);
+        }
+    }
+    if !apply {
+        if claim.is_none() {
+            let collision: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM bw_claims WHERE domain=? COLLATE NOCASE AND local_part=? COLLATE NOCASE")
+                .bind(&c.domain).bind(&c.local_part).fetch_one(&mut *tx).await?;
+            if collision != 0 {
+                return Err(Failure::Conflict);
+            }
+            sqlx::query("INSERT INTO bw_claims(city_id,domain,local_part) VALUES(?,?,?)")
+                .bind(&c.city_id)
+                .bind(&c.domain)
+                .bind(&c.local_part)
+                .execute(&mut *tx)
+                .await?;
+        }
+        sqlx::query(
+            "INSERT INTO bw_configs(city_id,version,hash,config,state) VALUES(?,?,?,?,'prepared')",
+        )
+        .bind(&c.city_id)
+        .bind(c.version as i64)
+        .bind(c.hash())
+        .bind(serde_json::to_string(c).unwrap())
+        .execute(&mut *tx)
+        .await?;
+    } else {
+        let user_id = if let Some(id) = claimed_id {
+            sqlx::query("UPDATE users SET nostr_pubkey=? WHERE id=?")
+                .bind(&c.brand_pubkey)
+                .bind(id)
+                .execute(&mut *tx)
+                .await?;
+            id
+        } else {
+            let id: i64 = sqlx::query_scalar("INSERT INTO users(username,domain,nostr_pubkey,is_prism,nwc_uri) VALUES(?,?,?,1,NULL) RETURNING id")
+                .bind(&c.local_part).bind(&c.domain).bind(&c.brand_pubkey).fetch_one(&mut *tx).await?;
+            sqlx::query("UPDATE bw_claims SET user_id=? WHERE city_id=?")
+                .bind(id)
+                .bind(&c.city_id)
+                .execute(&mut *tx)
+                .await?;
+            id
+        };
+        sqlx::query("DELETE FROM prism_splits WHERE user_id=?")
+            .bind(user_id)
+            .execute(&mut *tx)
+            .await?;
+        sqlx::query(
+            "INSERT INTO prism_splits(user_id,lightning_address,percentage) VALUES(?,?,79)",
+        )
+        .bind(user_id)
+        .bind(&c.payout_destination)
+        .execute(&mut *tx)
+        .await?;
+        sqlx::query("UPDATE bw_configs SET state='applied' WHERE city_id=? AND version=?")
+            .bind(&c.city_id)
+            .bind(c.version as i64)
+            .execute(&mut *tx)
+            .await?;
+    }
+    tx.commit().await?;
+    Ok(receipt(c, if apply { "applied" } else { "prepared" }))
+}
+
+async fn write(
+    req: HttpRequest,
+    state: web::Data<State>,
+    path: web::Path<(String, String)>,
+    body: web::Bytes,
+) -> HttpResponse {
+    if !authorized(&req, &state) {
+        return error(Status::UNAUTHORIZED);
+    }
+    let (id, action) = path.into_inner();
+    if !["prepare", "apply"].contains(&action.as_str()) {
+        return error(Status::NOT_FOUND);
+    }
+    let Ok(cmd) = serde_json::from_slice::<Command>(&body) else {
+        return error(Status::BAD_REQUEST);
+    };
+    let c = &cmd.config;
+    if cmd.api != API
+        || id != c.city_id
+        || !c.valid(&state.domain, state.managed)
+        || !state.wallets.contains(&c.wallet_ref)
+        || cmd.expected_version != c.version - 1
+        || cmd.idempotency_key != format!("{}:{}:{}", c.city_id, c.version, c.hash())
+    {
+        return error(Status::BAD_REQUEST);
+    }
+    match change(&state, &cmd, action == "apply").await {
+        Ok(r) => HttpResponse::Ok()
+            .insert_header(("Cache-Control", "no-store"))
+            .json(r),
+        Err(Failure::Conflict) => error(Status::CONFLICT),
+        Err(Failure::Storage) => error(Status::SERVICE_UNAVAILABLE),
+    }
+}
+
+fn public_error(status: Status) -> HttpResponse {
+    HttpResponse::build(status)
+        .insert_header(("Cache-Control", "no-store"))
+        .json(
+            serde_json::json!({"status":"ERROR","reason":"Payment request could not be completed"}),
+        )
+}
+
+fn request_host(req: &HttpRequest, domain: &str) -> Option<String> {
+    let host = req.headers().get("host")?.to_str().ok()?;
+    let hostname = host.split(':').next()?;
+    if hostname.eq_ignore_ascii_case(domain) {
+        Some(host.to_owned())
+    } else {
+        None
+    }
+}
+
+async fn public_config(state: &State, local_part: &str) -> Option<Config> {
+    if !LABEL.is_match(local_part) || local_part.len() > 63 {
+        return None;
+    }
+    let row = sqlx::query(
+        "SELECT bw_configs.config FROM bw_claims JOIN bw_configs ON bw_configs.city_id=bw_claims.city_id WHERE bw_claims.domain=? COLLATE NOCASE AND bw_claims.local_part=? COLLATE NOCASE AND bw_configs.state='applied' ORDER BY bw_configs.version DESC LIMIT 1",
+    )
+    .bind(&state.domain)
+    .bind(local_part)
+    .fetch_optional(&state.pool)
+    .await
+    .ok()??;
+    let config: Config = serde_json::from_str(row.get("config")).ok()?;
+    if config.invoice_issuance != "enabled" || !config.valid(&state.domain, true) {
+        return None;
+    }
+    let mut tx = state.pool.begin().await.ok()?;
+    verify_applied(&mut tx, &config).await.ok()?;
+    Some(config)
+}
+
+fn lnurl_metadata(config: &Config) -> String {
+    serde_json::json!([[
+        "text/plain",
+        format!("Support BitcoinWalk in {}", config.local_part)
+    ]])
+    .to_string()
+}
+
+async fn public_nip05(
+    req: HttpRequest,
+    state: web::Data<State>,
+    query: web::Query<std::collections::HashMap<String, String>>,
+) -> HttpResponse {
+    if request_host(&req, &state.domain).is_none() {
+        return public_error(Status::NOT_FOUND);
+    }
+    let Some(name) = query.get("name") else {
+        return HttpResponse::Ok().json(serde_json::json!({"names":{}}));
+    };
+    match public_config(&state, name).await {
+        Some(config) => HttpResponse::Ok()
+            .insert_header(("Access-Control-Allow-Origin", "*"))
+            .json(serde_json::json!({"names":{config.local_part:config.brand_pubkey}})),
+        None => HttpResponse::Ok()
+            .insert_header(("Access-Control-Allow-Origin", "*"))
+            .json(serde_json::json!({"names":{}})),
+    }
+}
+
+async fn public_lnurl(
+    req: HttpRequest,
+    state: web::Data<State>,
+    path: web::Path<String>,
+) -> HttpResponse {
+    if request_host(&req, &state.domain).is_none() {
+        return public_error(Status::NOT_FOUND);
+    }
+    let Some(config) = public_config(&state, &path).await else {
+        return public_error(Status::NOT_FOUND);
+    };
+    HttpResponse::Ok()
+        .insert_header(("Cache-Control", "no-store"))
+        .json(serde_json::json!({
+            "tag":"payRequest",
+            "callback":format!("https://{}/lnurlp/{}/callback",state.domain,config.local_part),
+            "minSendable":1000,
+            "maxSendable":1_000_000_000u64,
+            "metadata":lnurl_metadata(&config)
+        }))
+}
+
+fn request_id() -> String {
+    let mut bytes = [0u8; 16];
+    rand::thread_rng().fill_bytes(&mut bytes);
+    bytes[6] = (bytes[6] & 0x0f) | 0x40;
+    bytes[8] = (bytes[8] & 0x3f) | 0x80;
+    format!(
+        "{:02x}{:02x}{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}-{:02x}{:02x}{:02x}{:02x}{:02x}{:02x}",
+        bytes[0],
+        bytes[1],
+        bytes[2],
+        bytes[3],
+        bytes[4],
+        bytes[5],
+        bytes[6],
+        bytes[7],
+        bytes[8],
+        bytes[9],
+        bytes[10],
+        bytes[11],
+        bytes[12],
+        bytes[13],
+        bytes[14],
+        bytes[15]
+    )
+}
+
+async fn public_callback(
+    req: HttpRequest,
+    state: web::Data<State>,
+    path: web::Path<String>,
+    query: web::Query<std::collections::HashMap<String, String>>,
+) -> HttpResponse {
+    if request_host(&req, &state.domain).is_none() {
+        return public_error(Status::NOT_FOUND);
+    }
+    let Some(config) = public_config(&state, &path).await else {
+        return public_error(Status::NOT_FOUND);
+    };
+    let Some(amount) = query
+        .get("amount")
+        .and_then(|value| value.parse::<u64>().ok())
+    else {
+        return public_error(Status::BAD_REQUEST);
+    };
+    if !(1_000..=1_000_000_000).contains(&amount) {
+        return public_error(Status::BAD_REQUEST);
+    }
+    let commitment = if let Some(nostr) = query.get("nostr") {
+        if nostr.len() > 12_288
+            || serde_json::from_str::<serde_json::Value>(nostr)
+                .ok()
+                .and_then(|value| value.as_object().cloned())
+                .is_none()
+        {
+            return public_error(Status::BAD_REQUEST);
+        }
+        format!("{:x}", Sha256::digest(nostr.as_bytes()))
+    } else {
+        format!("{:x}", Sha256::digest(lnurl_metadata(&config).as_bytes()))
+    };
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|duration| duration.as_secs())
+        .unwrap_or(0);
+    let existing = sqlx::query("SELECT request_id,requested_at,invoice,payment_hash,expires_at FROM bw_public_invoices WHERE city_id=? AND payout_version=? AND amount_msat=? AND description_hash=? AND state IN ('pending','issued') AND requested_at>? AND (expires_at IS NULL OR expires_at>?) ORDER BY requested_at DESC LIMIT 1")
+        .bind(&config.city_id).bind(config.payout_version as i64).bind(amount as i64).bind(&commitment).bind((now.saturating_sub(86_400)) as i64).bind((now + 60) as i64)
+        .fetch_optional(&state.pool).await;
+    let Ok(existing) = existing else {
+        return public_error(Status::SERVICE_UNAVAILABLE);
+    };
+    if let Some(row) = &existing {
+        if let (Some(invoice), Some(payment_hash)) = (
+            row.get::<Option<String>, _>("invoice"),
+            row.get::<Option<String>, _>("payment_hash"),
+        ) {
+            return HttpResponse::Ok().insert_header(("Cache-Control", "no-store")).json(serde_json::json!({
+                "pr":invoice,"routes":[],"verify":format!("https://{}/lnurlp/{}/verify/{payment_hash}",state.domain,config.local_part)
+            }));
+        }
+    }
+    let (id, requested_at) = if let Some(row) = existing {
+        (
+            row.get::<String, _>("request_id"),
+            row.get::<i64, _>("requested_at") as u64,
+        )
+    } else {
+        let id = request_id();
+        if sqlx::query("INSERT INTO bw_public_invoices(request_id,city_id,payout_version,amount_msat,description_hash,requested_at,state) VALUES(?,?,?,?,?,?,'pending')")
+            .bind(&id).bind(&config.city_id).bind(config.payout_version as i64).bind(amount as i64).bind(&commitment).bind(now as i64)
+            .execute(&state.pool).await.is_err() {
+            return public_error(Status::SERVICE_UNAVAILABLE);
+        }
+        (id, now)
+    };
+    let Some(broker) = &state.broker else {
+        return public_error(Status::SERVICE_UNAVAILABLE);
+    };
+    let issued = broker
+        .issue(&IssueRequest::new(
+            id.clone(),
+            config.city_id.clone(),
+            config.payout_version,
+            amount,
+            commitment,
+            requested_at,
+        ))
+        .await;
+    let Ok(issued) = issued else {
+        return public_error(Status::SERVICE_UNAVAILABLE);
+    };
+    if sqlx::query("UPDATE bw_public_invoices SET state='issued',invoice=?,payment_hash=?,issued_at=?,expires_at=? WHERE request_id=? AND state IN ('pending','issued')")
+        .bind(&issued.invoice).bind(&issued.payment_hash).bind(issued.issued_at as i64).bind(issued.expires_at as i64).bind(&id)
+        .execute(&state.pool).await.is_err() {
+        return public_error(Status::SERVICE_UNAVAILABLE);
+    }
+    HttpResponse::Ok().insert_header(("Cache-Control", "no-store")).json(serde_json::json!({
+        "pr":issued.invoice,"routes":[],"verify":format!("https://{}/lnurlp/{}/verify/{}",state.domain,config.local_part,issued.payment_hash)
+    }))
+}
+
+async fn public_verify(
+    req: HttpRequest,
+    state: web::Data<State>,
+    path: web::Path<(String, String)>,
+) -> HttpResponse {
+    if request_host(&req, &state.domain).is_none() {
+        return public_error(Status::NOT_FOUND);
+    }
+    let (local_part, payment_hash) = path.into_inner();
+    if !HEX.is_match(&payment_hash) {
+        return public_error(Status::NOT_FOUND);
+    }
+    let Some(config) = public_config(&state, &local_part).await else {
+        return public_error(Status::NOT_FOUND);
+    };
+    let found: Option<i64> = sqlx::query_scalar("SELECT 1 FROM bw_public_invoices WHERE city_id=? AND payout_version=? AND payment_hash=? AND state='issued'")
+        .bind(&config.city_id).bind(config.payout_version as i64).bind(&payment_hash).fetch_optional(&state.pool).await.ok().flatten();
+    if found.is_none() {
+        return public_error(Status::NOT_FOUND);
+    }
+    let Some(broker) = &state.broker else {
+        return public_error(Status::SERVICE_UNAVAILABLE);
+    };
+    match broker
+        .status(&config.city_id, config.payout_version, &payment_hash)
+        .await
+    {
+        Ok(status) => HttpResponse::Ok()
+            .insert_header(("Cache-Control", "no-store"))
+            .json(serde_json::json!({"settled":status.settled})),
+        Err(_) => public_error(Status::SERVICE_UNAVAILABLE),
+    }
+}
+
+fn routes(cfg: &mut web::ServiceConfig) {
+    cfg.app_data(web::PayloadConfig::new(16_384))
+        .route("/v1/bitcoinwalk/capabilities", web::get().to(capabilities))
+        .route("/v1/bitcoinwalk/cities/{id}", web::get().to(read_status))
+        .route(
+            "/v1/bitcoinwalk/cities/{id}/{action}",
+            web::post().to(write),
+        );
+}
+fn managed_routes(cfg: &mut web::ServiceConfig) {
+    routes(cfg);
+    cfg.route("/.well-known/nostr.json", web::get().to(public_nip05))
+        .route(
+            "/.well-known/lnurlp/{username}",
+            web::get().to(public_lnurl),
+        )
+        .route("/lnurlp/{username}", web::get().to(public_lnurl))
+        .route(
+            "/lnurlp/{username}/callback",
+            web::get().to(public_callback),
+        )
+        .route(
+            "/lnurlp/{username}/verify/{payment_hash}",
+            web::get().to(public_verify),
+        );
+}
+async fn migrate(pool: &SqlitePool) -> Result<(), sqlx::Error> {
+    crate::db::run_migrations(pool).await;
+    for sql in [
+        "CREATE TABLE IF NOT EXISTS bw_lock(id INTEGER PRIMARY KEY,value INTEGER NOT NULL)",
+        "INSERT OR IGNORE INTO bw_lock VALUES(1,0)",
+        "CREATE TABLE IF NOT EXISTS bw_claims(city_id TEXT PRIMARY KEY,domain TEXT NOT NULL COLLATE NOCASE,local_part TEXT NOT NULL COLLATE NOCASE,user_id INTEGER UNIQUE,UNIQUE(domain,local_part))",
+        "CREATE TABLE IF NOT EXISTS bw_configs(city_id TEXT NOT NULL,version INTEGER NOT NULL,hash TEXT NOT NULL,config TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN ('prepared','applied')),PRIMARY KEY(city_id,version))",
+        "CREATE TABLE IF NOT EXISTS bw_public_invoices(request_id TEXT PRIMARY KEY,city_id TEXT NOT NULL,payout_version INTEGER NOT NULL,amount_msat INTEGER NOT NULL,description_hash TEXT NOT NULL,requested_at INTEGER NOT NULL,state TEXT NOT NULL CHECK(state IN ('pending','issued')),invoice TEXT,payment_hash TEXT UNIQUE,issued_at INTEGER,expires_at INTEGER)",
+        "CREATE INDEX IF NOT EXISTS bw_public_invoice_match ON bw_public_invoices(city_id,payout_version,amount_msat,description_hash,requested_at)",
+    ] {
+        sqlx::query(sql).execute(pool).await?;
+    }
+    Ok(())
+}
+fn unavailable() -> std::io::Error {
+    std::io::Error::other("Isolated provisioning configuration invalid; no live service started")
+}
+async fn serve_mode(managed: bool) -> std::io::Result<()> {
+    #[cfg(unix)]
+    if unsafe { libc::geteuid() } == 0 {
+        return Err(unavailable());
+    }
+    let domain = std::env::var("BW_PROVISION_DOMAIN").map_err(|_| unavailable())?;
+    let revision = std::env::var("BW_PROVISION_REVISION").map_err(|_| unavailable())?;
+    let token_path = std::env::var("BW_PROVISION_TOKEN_FILE").map_err(|_| unavailable())?;
+    let db_path = std::env::var(if managed {
+        "BW_MANAGED_DB"
+    } else {
+        "BW_PROVISION_TEST_DB"
+    })
+    .map_err(|_| unavailable())?;
+    let port: u16 = std::env::var("BW_PROVISION_PORT")
+        .unwrap_or(if managed {
+            "8895".into()
+        } else {
+            "8890".into()
+        })
+        .parse()
+        .map_err(|_| unavailable())?;
+    let wallets: Vec<String> = std::env::var("BW_PROVISION_WALLET_REFS")
+        .unwrap_or(if managed {
+            "bitcoinwalk-rustress".into()
+        } else {
+            "isolated-test".into()
+        })
+        .split(',')
+        .map(str::to_string)
+        .collect();
+    if !DOMAIN.is_match(&domain)
+        || domain.len() > 253
+        || !HEX.is_match(&revision)
+        || port == 0
+        || !Path::new(&db_path).is_absolute()
+        || !(if managed {
+            db_path.ends_with(".managed.sqlite")
+        } else {
+            db_path.ends_with(".fixture.sqlite")
+        })
+        || wallets.is_empty()
+        || wallets.iter().any(|w| !LABEL.is_match(w) || w.len() > 63)
+        || std::env::var_os("NIP57_PRIVATE_KEY").is_some()
+        || std::env::var_os("DATABASE_URL").is_some()
+    {
+        return Err(unavailable());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let meta = std::fs::symlink_metadata(&token_path).map_err(|_| unavailable())?;
+        if !meta.is_file() || meta.len() > 1024 || meta.permissions().mode() & 0o077 != 0 {
+            return Err(unavailable());
+        }
+    }
+    let token = std::fs::read_to_string(token_path).map_err(|_| unavailable())?;
+    let token = token.trim();
+    if !(43..=256).contains(&token.len())
+        || !token
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b"_-".contains(&b))
+    {
+        return Err(unavailable());
+    }
+    // Exclusive create prevents silently taking an existing upstream database.
+    // Existing files require our isolated marker BEFORE any upstream migration.
+    if Path::new(&db_path).exists()
+        && std::fs::symlink_metadata(&db_path)
+            .map_err(|_| unavailable())?
+            .file_type()
+            .is_symlink()
+    {
+        return Err(unavailable());
+    }
+    let fresh = match std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&db_path)
+    {
+        Ok(_) => {
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                std::fs::set_permissions(&db_path, std::fs::Permissions::from_mode(0o600))?;
+            }
+            true
+        }
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => false,
+        Err(_) => return Err(unavailable()),
+    };
+    let options = SqliteConnectOptions::from_str(&format!("sqlite://{db_path}"))
+        .map_err(|_| unavailable())?
+        .busy_timeout(Duration::from_secs(5));
+    let pool = SqlitePool::connect_with(options)
+        .await
+        .map_err(|_| unavailable())?;
+    let marker = if managed {
+        "bw_managed_marker"
+    } else {
+        "bw_isolated_marker"
+    };
+    if fresh {
+        sqlx::query(&format!(
+            "CREATE TABLE {marker}(id INTEGER PRIMARY KEY CHECK(id=1))"
+        ))
+        .execute(&pool)
+        .await
+        .map_err(|_| unavailable())?;
+        sqlx::query(&format!("INSERT INTO {marker} VALUES(1)"))
+            .execute(&pool)
+            .await
+            .map_err(|_| unavailable())?;
+    } else if sqlx::query_scalar::<_, i64>(&format!("SELECT id FROM {marker}"))
+        .fetch_optional(&pool)
+        .await
+        .ok()
+        .flatten()
+        != Some(1)
+    {
+        return Err(unavailable());
+    }
+    migrate(&pool).await.map_err(|_| unavailable())?;
+    let secrets: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM users WHERE nwc_uri IS NOT NULL")
+        .fetch_one(&pool)
+        .await
+        .map_err(|_| unavailable())?;
+    if secrets != 0 {
+        return Err(unavailable());
+    }
+    let broker = if managed {
+        let path = std::env::var("BW_INVOICE_ISSUER_TOKEN_FILE").map_err(|_| unavailable())?;
+        Some(InvoiceBroker::from_token_file(&path).map_err(|_| unavailable())?)
+    } else {
+        None
+    };
+    let state = web::Data::new(State {
+        pool,
+        token_hash: Sha256::digest(token.as_bytes()).into(),
+        domain,
+        revision,
+        wallets,
+        managed,
+        broker,
+    });
+    HttpServer::new(move || {
+        let app = App::new().app_data(state.clone());
+        if managed {
+            app.configure(managed_routes)
+        } else {
+            app.configure(routes)
+        }
+    })
+    .bind(("127.0.0.1", port))?
+    .run()
+    .await
+}
+
+pub async fn serve() -> std::io::Result<()> {
+    serve_mode(false).await
+}
+
+pub async fn serve_managed() -> std::io::Result<()> {
+    serve_mode(true).await
+}
