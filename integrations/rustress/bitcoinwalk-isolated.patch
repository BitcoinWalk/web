index 0000000..c9edf76
--- /dev/null
+++ w/src/bitcoinwalk_issuer.rs
@@ -0,0 +1,233 @@
+//! Private BitcoinWalk invoice-broker client. It never reads an NWC credential:
+//! Rustress submits invoice facts to the loopback payout service, which creates
+//! and records the invoice before returning it.
+use reqwest::{Client, StatusCode};
+use serde::{Deserialize, Serialize};
+use std::{path::Path, time::Duration};
+
+const API: &str = "bitcoinwalk-payout-issue-v1";
+const ORIGIN: &str = "http://127.0.0.1:8893";
+
+#[derive(Clone)]
+pub struct InvoiceBroker {
+    client: Client,
+    token: String,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct IssueRequest {
+    pub api: &'static str,
+    pub request_id: String,
+    pub city_id: String,
+    pub payout_version: u64,
+    pub amount_msat: String,
+    pub description_hash: String,
+    pub requested_at: u64,
+    pub expiry_seconds: u64,
+}
+
+impl IssueRequest {
+    pub fn new(
+        request_id: String,
+        city_id: String,
+        payout_version: u64,
+        amount_msat: u64,
+        description_hash: String,
+        requested_at: u64,
+    ) -> Self {
+        Self {
+            api: API,
+            request_id,
+            city_id,
+            payout_version,
+            amount_msat: amount_msat.to_string(),
+            description_hash,
+            requested_at,
+            expiry_seconds: 3600,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct IssuedInvoice {
+    pub invoice: String,
+    pub payment_hash: String,
+    pub amount_msat: String,
+    pub issued_at: u64,
+    pub expires_at: u64,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct StatusRequest<'a> {
+    api: &'static str,
+    city_id: &'a str,
+    payout_version: u64,
+    payment_hash: &'a str,
+}
+
+#[derive(Debug, Deserialize, PartialEq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct InvoiceStatus {
+    api: String,
+    pub payment_hash: String,
+    pub settled: bool,
+}
+
+fn valid_hex(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+}
+
+impl InvoiceBroker {
+    pub fn from_token_file(path: &str) -> Result<Self, ()> {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::{MetadataExt, PermissionsExt};
+            let metadata = std::fs::symlink_metadata(path).map_err(|_| ())?;
+            if !metadata.is_file()
+                || metadata.file_type().is_symlink()
+                || metadata.nlink() != 1
+                || metadata.permissions().mode() & 0o077 != 0
+                || metadata.len() > 1024
+            {
+                return Err(());
+            }
+        }
+        if !Path::new(path).is_absolute() {
+            return Err(());
+        }
+        let token = std::fs::read_to_string(path).map_err(|_| ())?;
+        let token = token.trim();
+        if !(43..=256).contains(&token.len())
+            || !token
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || b"_-".contains(&byte))
+        {
+            return Err(());
+        }
+        let client = Client::builder()
+            .timeout(Duration::from_secs(20))
+            .redirect(reqwest::redirect::Policy::none())
+            .build()
+            .map_err(|_| ())?;
+        Ok(Self {
+            client,
+            token: token.to_owned(),
+        })
+    }
+
+    async fn post<T: Serialize, R: for<'de> Deserialize<'de>>(
+        &self,
+        path: &str,
+        body: &T,
+    ) -> Result<R, ()> {
+        let response = self
+            .client
+            .post(format!("{ORIGIN}{path}"))
+            .bearer_auth(&self.token)
+            .header("Accept", "application/json")
+            .json(body)
+            .send()
+            .await
+            .map_err(|_| ())?;
+        if response.status() != StatusCode::OK
+            || response
+                .content_length()
+                .is_some_and(|length| length > 16_384)
+        {
+            return Err(());
+        }
+        let bytes = response.bytes().await.map_err(|_| ())?;
+        if bytes.len() > 16_384 {
+            return Err(());
+        }
+        serde_json::from_slice(&bytes).map_err(|_| ())
+    }
+
+    pub async fn issue(&self, request: &IssueRequest) -> Result<IssuedInvoice, ()> {
+        if request.api != API
+            || !(1_000..=1_000_000_000)
+                .contains(&request.amount_msat.parse::<u64>().map_err(|_| ())?)
+            || !valid_hex(&request.description_hash)
+        {
+            return Err(());
+        }
+        let invoice: IssuedInvoice = self.post("/v1/invoices/issue", request).await?;
+        if invoice.amount_msat != request.amount_msat
+            || !valid_hex(&invoice.payment_hash)
+            || !invoice.invoice.starts_with("lnbc")
+            || invoice.expires_at <= invoice.issued_at
+        {
+            return Err(());
+        }
+        Ok(invoice)
+    }
+
+    pub async fn status(
+        &self,
+        city_id: &str,
+        payout_version: u64,
+        payment_hash: &str,
+    ) -> Result<InvoiceStatus, ()> {
+        if !valid_hex(payment_hash) {
+            return Err(());
+        }
+        let status: InvoiceStatus = self
+            .post(
+                "/v1/invoices/status",
+                &StatusRequest {
+                    api: API,
+                    city_id,
+                    payout_version,
+                    payment_hash,
+                },
+            )
+            .await?;
+        if status.api != API || status.payment_hash != payment_hash {
+            return Err(());
+        }
+        Ok(status)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn validates_requests_without_wallet_or_network_access() {
+        let valid = IssueRequest::new(
+            "00000000-0000-4000-8000-000000000001".into(),
+            "00000000-0000-4000-8000-000000000002".into(),
+            1,
+            100_000,
+            "ab".repeat(32),
+            1_800_000_000,
+        );
+        assert_eq!(valid.api, API);
+        assert_eq!(valid.amount_msat, "100000");
+        assert!(valid_hex(&valid.description_hash));
+        assert!(!valid_hex(&"AB".repeat(32)));
+    }
+
+    #[test]
+    fn strict_response_shapes_reject_private_or_extra_fields() {
+        let json = format!(
+            r#"{{"invoice":"lnbc1test","paymentHash":"{}","amountMsat":"100000","issuedAt":1,"expiresAt":2}}"#,
+            "ab".repeat(32)
+        );
+        assert!(serde_json::from_str::<IssuedInvoice>(&json).is_ok());
+        assert!(
+            serde_json::from_str::<IssuedInvoice>(&format!(
+                "{},\"destination\":\"private@example.org\"}}",
+                &json[..json.len() - 1]
+            ))
+            .is_err()
+        );
+    }
+}
