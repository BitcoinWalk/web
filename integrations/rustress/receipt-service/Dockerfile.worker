FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
LABEL org.bitcoinwalk.service="rustress-receipt-worker" org.bitcoinwalk.mode="disabled"
WORKDIR /app
COPY rustress-receipt-worker.cjs initialize-rustress-receipt-worker.cjs verify-rustress-receipt-worker.cjs backup-sqlite-online.mjs ./
USER 0:0
EXPOSE 8894
ENTRYPOINT ["node","/app/rustress-receipt-worker.cjs"]
