FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
LABEL org.bitcoinwalk.service="rustress-receipt-signer" org.bitcoinwalk.network="none"
WORKDIR /app
COPY rustress-receipt-signer.cjs initialize-rustress-receipt-identity.cjs verify-rustress-receipt-restore.cjs backup-sqlite-online.mjs ./
USER 0:0
ENTRYPOINT ["node","/app/rustress-receipt-signer.cjs"]
